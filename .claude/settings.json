{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "filePattern": "**/*.{ts,tsx,js,jsx}",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bun run format \"$(jq -r '.tool_input.file_path')\""
          }
        ]
      }
    ]
  }
}
