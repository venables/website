{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "react",
    "react-perf",
    "oxc",
    "import",
    "jsdoc",
    "jsx-a11y",
    "node",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "ignorePatterns": ["post-hog.astro", "pgp.astro"],
  "rules": {
    "no-console": "warn",
    "typescript/no-explicit-any": "error",
    "typescript/no-misused-promises": "warn"
  },
  "overrides": [
    {
      "files": ["**/layout.astro"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": ["*.test.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": ["*.d.ts"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
