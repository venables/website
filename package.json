{
  "name": "@venables/website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "pnpm run typegen && pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "clean": "git clean -xdf .astro node_modules/.cache",
    "dev": "astro dev",
    "fix": "pnpm run format && pnpm run lint:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix --fix-suggestions --fix-dangerously",
    "nuke": "pnpm run clean; git clean -xdf node_modules",
    "outdated": "npx npm-check-updates --interactive --format group",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit --pretty",
    "typegen": "astro sync"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.1.1",
    "@lucide/astro": "1.23.0",
    "@resvg/resvg-wasm": "2.6.2",
    "astro": "7.0.6",
    "astro-seo": "1.1.0",
    "clsx": "2.1.1",
    "satori": "0.26.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "7.0.2",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.2",
    "@types/node": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "tailwindcss": "4.3.2",
    "typescript": "^6.0.3",
    "wrangler": "latest"
  },
  "packageManager": "pnpm@10.32.1"
}
