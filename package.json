{
  "name": "@venables/website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "bun run typegen && bun run format:check && bun run lint && bun run typecheck",
    "clean": "git clean -xdf .astro node_modules/.cache",
    "dev": "astro dev",
    "fix": "bun run format && bun run lint:fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix --fix-suggestions --fix-dangerously",
    "nuke": "bun run clean; git clean -xdf node_modules",
    "outdated": "npx npm-check-updates --interactive --format group",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit --pretty",
    "typegen": "astro sync"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@fontsource-variable/geist-mono": "5.2.7",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@lucide/astro": "0.562.0",
    "astro": "5.16.8",
    "astro-seo": "0.8.4",
    "clsx": "2.1.1",
    "tailwind-merge": "3.4.0",
    "valibot": "1.2.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "4.3.13",
    "@astrojs/rss": "4.0.14",
    "@astrojs/sitemap": "3.6.1",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.1.18",
    "@types/bun": "1.3.5",
    "oxfmt": "0.23.0",
    "oxlint": "1.38.0",
    "oxlint-tsgolint": "0.11.0",
    "tailwindcss": "4.1.18",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "wrangler": "4.58.0"
  }
}
