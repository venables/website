{
  "name": "@venables/website",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "check": "bun run typegen && bun run format:check && bun run lint && bun run typecheck",
    "clean": "git clean -xdf .astro node_modules/.cache",
    "dev": "astro dev",
    "fix": "bun run format && bun run lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "nuke": "bun run clean; git clean -xdf node_modules",
    "outdated": "npx npm-check-updates --interactive --format group",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit --pretty",
    "typegen": "astro sync"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "5.2.7",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@lucide/astro": "0.545.0",
    "astro": "5.14.5",
    "astro-seo": "0.8.4",
    "clsx": "2.1.1",
    "tailwind-merge": "3.3.1",
    "valibot": "1.1.0"
  },
  "devDependencies": {
    "@astrojs/mdx": "4.3.7",
    "@astrojs/rss": "4.0.12",
    "@astrojs/sitemap": "3.6.0",
    "@astrojs/vercel": "8.2.10",
    "@eslint/js": "9.37.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@prettier/plugin-oxc": "0.0.4",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.1.14",
    "@types/bun": "1.3.0",
    "eslint": "9.37.0",
    "eslint-config-flat-gitignore": "2.1.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.3.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-packagejson": "2.5.19",
    "prettier-plugin-tailwindcss": "0.7.0",
    "tailwindcss": "4.1.14",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}
