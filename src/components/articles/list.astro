---
import { getCollection } from "astro:content"

const allPosts = await getCollection("posts")
const posts = allPosts.toSorted((a, b) => {
  const dateA = a.data.pubDate?.getTime() ?? 0
  const dateB = b.data.pubDate?.getTime() ?? 0
  return dateB - dateA
})

function formatYear(date: Date | undefined): string {
  return (date ?? new Date()).getFullYear().toString()
}
---

<ul class="not-prose flex list-none flex-col ps-0">
  {
    posts.map((post) => (
      <li>
        <a
          href={`/${post.id}`}
          class="group flex items-baseline justify-between gap-4 border-b border-border py-3 no-underline"
        >
          <span class="font-serif text-xl leading-snug tracking-tight transition-transform duration-150 group-hover:translate-x-1">
            {post.data.title}
          </span>
          <span class="label shrink-0 tabular-nums transition-colors group-hover:text-foreground">
            {formatYear(post.data.pubDate)}
          </span>
        </a>
      </li>
    ))
  }
</ul>
