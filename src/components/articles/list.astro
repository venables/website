---
import ArticleRow from "@/components/articles/article-row.astro"
import { getCollection } from "astro:content"

interface Props {
  limit?: number
}

const { limit } = Astro.props

const allPosts = await getCollection("posts")
const posts = allPosts.toSorted(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()
)

function year(date: Date): number {
  return date.getUTCFullYear()
}

const years = [...new Set(posts.map((post) => year(post.data.pubDate)))]
const groups = years.map((y) => ({
  year: y,
  posts: posts.filter((post) => year(post.data.pubDate) === y)
}))
---

{
  limit ? (
    <div class="not-prose group/list flex flex-col">
      <ul class="flex flex-col">
        {posts.slice(0, limit).map((post) => (
          <ArticleRow post={post} />
        ))}
      </ul>
    </div>
  ) : (
    <div class="not-prose group/list flex flex-col gap-10">
      {groups.map((group) => (
        <section class="flex flex-col">
          <h3 class="mb-1 border-b border-border pb-2 font-mono text-sm tabular-nums">
            {group.year}
          </h3>
          <ul class="flex flex-col">
            {group.posts.map((post) => (
              <ArticleRow post={post} />
            ))}
          </ul>
        </section>
      ))}
    </div>
  )
}
