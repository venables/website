---
import { getCollection } from "astro:content"

const allPosts = await getCollection("posts")
const posts = allPosts.toSorted((a, b) => {
  const dateA = a.data.pubDate?.getTime() ?? 0
  const dateB = b.data.pubDate?.getTime() ?? 0
  return dateB - dateA
})

function year(date: Date | undefined): number {
  return (date ?? new Date()).getFullYear()
}

function shortDate(date: Date | undefined): string {
  return (date ?? new Date()).toLocaleDateString("en-US", {
    month: "short",
    day: "2-digit"
  })
}

const years = [...new Set(posts.map((post) => year(post.data.pubDate)))]
const groups = years.map((y) => ({
  year: y,
  posts: posts.filter((post) => year(post.data.pubDate) === y)
}))
---

<div class="not-prose flex flex-col gap-10">
  {
    groups.map((group) => (
      <section class="flex flex-col">
        <h2 class="mb-1 border-b border-border pb-2 font-mono text-sm tabular-nums">
          {group.year}
        </h2>
        <ul class="group/list flex flex-col">
          {group.posts.map((post) => (
            <li>
              <a
                href={`/${post.id}`}
                class="grid grid-cols-[3.5rem_1fr] gap-x-4 py-3 no-underline transition-opacity duration-200 group-hover/list:opacity-40 hover:!opacity-100 sm:grid-cols-[4.5rem_1fr]"
              >
                <time class="pt-[0.35rem] font-mono text-xs tabular-nums text-muted-foreground">
                  {shortDate(post.data.pubDate)}
                </time>
                <span class="flex flex-col gap-1">
                  <span class="font-serif text-lg leading-snug">
                    {post.data.title}
                  </span>
                  {post.data.description && (
                    <span class="text-sm leading-snug text-muted-foreground">
                      {post.data.description}
                    </span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
