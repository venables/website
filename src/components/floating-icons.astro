---
import mattAvatar from "@/assets/images/icons/matt-avatar.png"
import dunkinIced from "@/assets/images/icons/dunkin-iced.png"
import { Image } from "astro:assets"
import { siteConfig } from "@/config/site"

import rocket from "@/assets/images/icons/rocket.png"
import floppyDisk from "@/assets/images/icons/floppy-disk.png"
import joystick from "@/assets/images/icons/joystick.png"
import pager from "@/assets/images/icons/pager.png"
import globe from "@/assets/images/icons/globe.png"
import lightning from "@/assets/images/icons/lightning.png"
import crystalBall from "@/assets/images/icons/crystal-ball.png"
import gameController from "@/assets/images/icons/game-controller.png"
import opticalDisk from "@/assets/images/icons/optical-disk.png"
import satellite from "@/assets/images/icons/satellite.png"
import flyingSaucer from "@/assets/images/icons/flying-saucer.png"
import battery from "@/assets/images/icons/battery.png"
import desktopComputer from "@/assets/images/icons/desktop-computer.png"
import keyboard from "@/assets/images/icons/keyboard.png"

interface FloatingIcon {
  image: ImageMetadata
  offsetX: number
  offsetY: number
  rotation: number
  scale: number
}

const icons: FloatingIcon[] = [
  { image: rocket, offsetX: 12, offsetY: 8, rotation: -15, scale: 1.8 },
  { image: floppyDisk, offsetX: -8, offsetY: 15, rotation: 22, scale: 0.6 },
  { image: joystick, offsetX: 20, offsetY: -12, rotation: -8, scale: 1.2 },
  { image: pager, offsetX: -15, offsetY: 20, rotation: 35, scale: 0.8 },
  { image: globe, offsetX: 25, offsetY: 5, rotation: -25, scale: 1.5 },
  { image: lightning, offsetX: -20, offsetY: -18, rotation: 12, scale: 0.9 },
  { image: crystalBall, offsetX: 18, offsetY: 22, rotation: -30, scale: 1.4 },
  { image: gameController, offsetX: -25, offsetY: -10, rotation: 18, scale: 0.7 },
  { image: opticalDisk, offsetX: 10, offsetY: 25, rotation: -12, scale: 1.6 },
  { image: satellite, offsetX: -12, offsetY: -22, rotation: 28, scale: 0.5 },
  { image: flyingSaucer, offsetX: 22, offsetY: -15, rotation: -20, scale: 1.8 },
  { image: battery, offsetX: -18, offsetY: 12, rotation: 15, scale: 0.8 },
  { image: desktopComputer, offsetX: 15, offsetY: -25, rotation: -35, scale: 1.1 },
  { image: keyboard, offsetX: -22, offsetY: 18, rotation: 8, scale: 0.6 },
]
---

<div class="floating-icons" aria-hidden="true" id="floating-icons">
  {icons.map((icon) => (
    <div
      class="icon floating"
      style={`--offset-x: ${icon.offsetX}; --offset-y: ${icon.offsetY}; --rotation: ${icon.rotation}; --scale: ${icon.scale};`}
    >
      <Image
        src={icon.image}
        alt=""
        width={64}
        height={64}
        class="emoji-img"
        loading="lazy"
        decoding="async"
      />
    </div>
  ))}
  <a
    href={siteConfig.links.x}
    target="_blank"
    rel="noopener noreferrer"
    class="icon avatar-icon floating"
    data-not-draggable
    data-hover-mode="party-mode"
    style="--offset-x: 8; --offset-y: 20; --rotation: -18; --scale: 2.8;"
  >
    <Image src={mattAvatar} alt="Matt Venables" class="avatar-img" />
  </a>
  <a
    href="https://www.youtube.com/watch?v=VV-ByP1_-B0"
    target="_blank"
    rel="noopener noreferrer"
    class="icon link-icon dunkin-icon floating"
    data-not-draggable
    data-hover-mode="dunkin-mode"
    style="--offset-x: -14; --offset-y: 16; --rotation: 12; --scale: 2.8;"
  >
    <Image src={dunkinIced} alt="Dunkin' Iced Coffee" width={64} height={64} class="emoji-img" />
  </a>
</div>

<style>
  .floating-icons {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 50;
    overflow: clip;
  }

  .icon {
    position: absolute;
    width: calc(2rem * var(--scale, 1));
    height: calc(2rem * var(--scale, 1));
    opacity: 0.9;
    cursor: grab;
    pointer-events: auto;
    user-select: none;
    filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.3));
  }

  .emoji-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  .icon:active {
    cursor: grabbing;
  }

  .icon.floating {
    animation: float-random infinite ease-in-out;
    animation-delay: calc(var(--offset-x) * -0.8s);
    animation-duration: calc(22s + var(--offset-y) * 0.15s);
  }

  .icon.dragging {
    z-index: 100;
    opacity: 1;
    filter: drop-shadow(4px 8px 12px rgba(0, 0, 0, 0.4));
  }

  .avatar-icon {
    width: calc(3rem * var(--scale, 1));
    height: calc(3rem * var(--scale, 1));
    opacity: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    background: transparent;
    transition: transform 0.2s ease-out, filter 0.2s ease-out;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
    border-radius: 50%;
    transition: opacity 0.2s ease-out;
  }

  .avatar-icon:hover {
    transform: scale(1.15) rotate(8deg);
    animation-play-state: paused;
  }

  .avatar-icon:hover .avatar-img {
    opacity: 0.85;
  }

  .avatar-icon:active {
    transform: scale(1.1) rotate(4deg);
  }

  .link-icon {
    cursor: pointer;
    text-decoration: none;
    transition: transform 0.2s ease-out, filter 0.2s ease-out;
  }

  .link-icon:hover {
    transform: scale(1.15) rotate(-8deg);
    animation-play-state: paused;
  }

  .link-icon:active {
    transform: scale(1.1) rotate(-4deg);
  }

  .dunkin-icon {
    width: calc(3rem * var(--scale, 1));
    height: calc(3rem * var(--scale, 1));
    opacity: 1;
  }

  [data-hover-mode]::after {
    content: "click me!";
    position: absolute;
    bottom: -1.8rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    background: var(--color-background);
    padding: 0.15rem 0.4rem;
    border-radius: 0.25rem;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease-out;
  }

  [data-hover-mode]:hover::after {
    opacity: 1;
  }

  @keyframes float-random {
    0%, 100% {
      transform: translate(0, 0);
    }
    20% {
      transform:
        translate(calc(var(--offset-x) * 3px), calc(var(--offset-y) * -2px))
        rotate(calc(var(--rotation) * 0.5deg));
    }
    40% {
      transform:
        translate(calc(var(--offset-x) * -2px), calc(var(--offset-y) * 3px))
        rotate(calc(var(--rotation) * -0.3deg));
    }
    60% {
      transform:
        translate(calc(var(--offset-x) * 2px), calc(var(--offset-y) * 2px))
        rotate(calc(var(--rotation) * 0.7deg));
    }
    80% {
      transform:
        translate(calc(var(--offset-x) * -3px), calc(var(--offset-y) * -1px))
        rotate(calc(var(--rotation) * -0.5deg));
    }
  }
</style>

<script>
  import { createDraggable } from "animejs"

  const SHAKE_THRESHOLD = 15
  const SHAKE_COUNT_REQUIRED = 3
  const SHAKE_COOLDOWN_MS = 1000

  const DRAGGABLE_SELECTOR = ".icon:not([data-not-draggable])"

  interface DraggableSelf {
    x: number
    y: number
    released: boolean
    setX(x: number, mute?: boolean): void
    setY(y: number, mute?: boolean): void
    coords: number[]
  }

  /**
   * Resets a draggable's internal offset and velocity tracking to zero.
   */
  function resetDraggableOffset(self: DraggableSelf): void {
    self.setX(0, true)
    self.setY(0, true)
    self.coords[0] = self.coords[2] = 0
    self.coords[1] = self.coords[3] = 0
  }

  /**
   * Computes a wrapped coordinate value when an icon exits the container bounds.
   *
   * Returns the adjusted base position if wrapping occurred, or the original
   * value if the icon is still within bounds.
   */
  function wrapAxis(
    visualPos: number,
    iconSize: number,
    containerSize: number,
    basePos: number,
  ): number {
    if (visualPos + iconSize < 0) return basePos + containerSize + iconSize
    if (visualPos > containerSize) return basePos - containerSize - iconSize
    return basePos
  }

  /**
   * Wraps an icon's position to the opposite edge when it exits the container.
   *
   * When `bakePosition` is true (used on settle), the draggable offset is folded
   * into the CSS position so the icon stays where it visually landed.
   */
  function wrapIconPosition(
    icon: HTMLElement,
    self: DraggableSelf,
    container: HTMLElement,
    bakePosition = false,
  ): void {
    const containerWidth = container.clientWidth
    const containerHeight = container.clientHeight
    const left = parseFloat(icon.style.left)
    const top = parseFloat(icon.style.top)
    const visualX = left + self.x
    const visualY = top + self.y

    const wrappedLeft = wrapAxis(visualX, icon.offsetWidth, containerWidth, left)
    const wrappedTop = wrapAxis(visualY, icon.offsetHeight, containerHeight, top)

    if (wrappedLeft === left && wrappedTop === top) return

    if (bakePosition) {
      const finalLeft = wrappedLeft + self.x
      const finalTop = wrappedTop + self.y
      resetDraggableOffset(self)
      icon.style.left = `${finalLeft}px`
      icon.style.top = `${finalTop}px`
    } else {
      icon.style.left = `${wrappedLeft}px`
      icon.style.top = `${wrappedTop}px`
    }
  }

  function setupFloatingIcons() {
    const container = document.getElementById("floating-icons")
    if (!container) return

    container.querySelectorAll<HTMLElement>(".icon").forEach((el) => {
      el.style.top = `${Math.random() * 50 + 5}%`
      el.style.left = `${Math.random() * 90 + 2}%`
    })

    container
      .querySelectorAll<HTMLElement>(DRAGGABLE_SELECTOR)
      .forEach((icon) => {
        createDraggable(icon, {
          releaseStiffness: 40,
          releaseDamping: 8,
          releaseMass: 1,
          velocityMultiplier: 1.2,
          onGrab(self) {
            const rect = icon.getBoundingClientRect()
            const containerRect = container.getBoundingClientRect()
            icon.classList.remove("floating")
            icon.classList.add("dragging")
            resetDraggableOffset(self)
            icon.style.left = `${rect.left - containerRect.left}px`
            icon.style.top = `${rect.top - containerRect.top}px`
          },
          onUpdate(self) {
            if (!self.released) return
            wrapIconPosition(icon, self, container)
          },
          onSettle(self) {
            wrapIconPosition(icon, self, container, true)
          },
          onRelease() {
            icon.classList.remove("dragging")
          },
        })
      })

    container
      .querySelectorAll<HTMLElement>("[data-hover-mode]")
      .forEach((el) => {
        const mode = el.dataset.hoverMode
        if (!mode) return
        el.addEventListener("mouseenter", () => {
          document.documentElement.classList.add(mode)
        })
        el.addEventListener("mouseleave", () => {
          document.documentElement.classList.remove(mode)
        })
      })

    setupShakeDetection(container)
  }

  function setupShakeDetection(container: HTMLElement) {
    if (
      !window.matchMedia("(pointer: coarse)").matches ||
      !("ondevicemotion" in window)
    ) {
      return
    }

    let lastX = 0
    let lastY = 0
    let lastZ = 0
    let shakeTimeout: ReturnType<typeof setTimeout> | null = null
    let shakeCount = 0

    window.addEventListener("devicemotion", (e: DeviceMotionEvent) => {
      const acc = e.accelerationIncludingGravity
      if (!acc) return

      const deltaX = Math.abs((acc.x ?? 0) - lastX)
      const deltaY = Math.abs((acc.y ?? 0) - lastY)
      const deltaZ = Math.abs((acc.z ?? 0) - lastZ)

      lastX = acc.x ?? 0
      lastY = acc.y ?? 0
      lastZ = acc.z ?? 0

      if (deltaX + deltaY + deltaZ > SHAKE_THRESHOLD) {
        shakeCount++

        if (shakeCount >= SHAKE_COUNT_REQUIRED && !shakeTimeout) {
          shakeCount = 0
          scatterIcons(container)
          shakeTimeout = setTimeout(() => {
            shakeTimeout = null
          }, SHAKE_COOLDOWN_MS)
        }
      }
    })
  }

  function scatterIcons(container: HTMLElement) {
    const rect = container.getBoundingClientRect()
    container
      .querySelectorAll<HTMLElement>(DRAGGABLE_SELECTOR)
      .forEach((icon) => {
        icon.classList.remove("floating")
        icon.style.left = `${Math.random() * (rect.width - 40)}px`
        icon.style.top = `${Math.random() * (rect.height - 40)}px`
      })
  }

  setupFloatingIcons()
</script>
