---
import avatar from "@/assets/images/matt-venables/avatar-transparent.png"
import { Image } from "astro:assets"
import { siteConfig } from "@/config/site"

interface FloatingIcon {
  emoji: string
  offsetX: number
  offsetY: number
  rotation: number
  scale: number
}

const icons: FloatingIcon[] = [
  { emoji: "\u{1F680}", offsetX: 12, offsetY: 8, rotation: -15, scale: 1.8 },
  { emoji: "\u{1F4BE}", offsetX: -8, offsetY: 15, rotation: 22, scale: 0.6 },
  { emoji: "\u{1F579}\u{FE0F}", offsetX: 20, offsetY: -12, rotation: -8, scale: 1.2 },
  { emoji: "\u{1F4DF}", offsetX: -15, offsetY: 20, rotation: 35, scale: 0.8 },
  { emoji: "\u{1F310}", offsetX: 25, offsetY: 5, rotation: -25, scale: 1.5 },
  { emoji: "\u{26A1}", offsetX: -20, offsetY: -18, rotation: 12, scale: 0.9 },
  { emoji: "\u{1F52E}", offsetX: 18, offsetY: 22, rotation: -30, scale: 1.4 },
  { emoji: "\u{1F3AE}", offsetX: -25, offsetY: -10, rotation: 18, scale: 0.7 },
  { emoji: "\u{1F4BF}", offsetX: 10, offsetY: 25, rotation: -12, scale: 1.6 },
  { emoji: "\u{1F4E1}", offsetX: -12, offsetY: -22, rotation: 28, scale: 0.5 },
  { emoji: "\u{1F6F8}", offsetX: 22, offsetY: -15, rotation: -20, scale: 1.8 },
  { emoji: "\u{1F50B}", offsetX: -18, offsetY: 12, rotation: 15, scale: 0.8 },
  { emoji: "\u{1F5A5}\u{FE0F}", offsetX: 15, offsetY: -25, rotation: -35, scale: 1.1 },
  { emoji: "\u{2328}\u{FE0F}", offsetX: -22, offsetY: 18, rotation: 8, scale: 0.6 },
]
---

<div class="floating-icons" aria-hidden="true" id="floating-icons">
  {icons.map((icon) => (
    <div
      class="icon floating"
      style={`--offset-x: ${icon.offsetX}; --offset-y: ${icon.offsetY}; --rotation: ${icon.rotation}; --scale: ${icon.scale};`}
    >
      {icon.emoji}
    </div>
  ))}
  <a
    href={siteConfig.links.x}
    target="_blank"
    rel="noopener noreferrer"
    class="icon avatar-icon floating"
    data-not-draggable
    style="--offset-x: 8; --offset-y: 20; --rotation: -18; --scale: 2.8;"
  >
    <Image src={avatar} alt="Matt Venables" class="avatar-img" />
  </a>
</div>

<style>
  .floating-icons {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 50;
    overflow: visible;
  }

  .icon {
    position: absolute;
    font-size: calc(2rem * var(--scale, 1));
    opacity: 0.9;
    cursor: grab;
    pointer-events: auto;
    user-select: none;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }

  .icon:active {
    cursor: grabbing;
  }

  .icon.floating {
    animation: float-random infinite ease-in-out;
    animation-delay: calc(var(--offset-x) * -0.8s);
    animation-duration: calc(22s + var(--offset-y) * 0.15s);
  }

  .icon.dragging {
    z-index: 100;
    opacity: 1;
  }

  .avatar-icon {
    width: calc(3rem * var(--scale, 1));
    height: calc(3rem * var(--scale, 1));
    opacity: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border-radius: 50%;
    cursor: pointer;
    text-decoration: none;
    background: transparent;
    transition: transform 0.2s ease-out, filter 0.2s ease-out;
  }

  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .avatar-icon:hover {
    transform: scale(1.15) rotate(8deg);
    filter: saturate(1.5) brightness(1.1) hue-rotate(15deg);
    animation-play-state: paused;
  }

  .avatar-icon:active {
    transform: scale(1.1) rotate(4deg);
  }

  @keyframes float-random {
    0%, 100% {
      transform: translate(0, 0);
    }
    20% {
      transform:
        translate(calc(var(--offset-x) * 3px), calc(var(--offset-y) * -2px))
        rotate(calc(var(--rotation) * 0.5deg));
    }
    40% {
      transform:
        translate(calc(var(--offset-x) * -2px), calc(var(--offset-y) * 3px))
        rotate(calc(var(--rotation) * -0.3deg));
    }
    60% {
      transform:
        translate(calc(var(--offset-x) * 2px), calc(var(--offset-y) * 2px))
        rotate(calc(var(--rotation) * 0.7deg));
    }
    80% {
      transform:
        translate(calc(var(--offset-x) * -3px), calc(var(--offset-y) * -1px))
        rotate(calc(var(--rotation) * -0.5deg));
    }
  }
</style>

<script>
  import { createDraggable } from "animejs"

  const SHAKE_THRESHOLD = 15
  const SHAKE_COUNT_REQUIRED = 3
  const SHAKE_COOLDOWN_MS = 1000

  const DRAGGABLE_SELECTOR = ".icon:not([data-not-draggable])"

  function setupFloatingIcons() {
    const container = document.getElementById("floating-icons")
    if (!container) return

    container.querySelectorAll<HTMLElement>(".icon").forEach((el) => {
      el.style.top = `${Math.random() * 50 + 5}%`
      el.style.left = `${Math.random() * 90 + 2}%`
    })

    container
      .querySelectorAll<HTMLElement>(DRAGGABLE_SELECTOR)
      .forEach((icon) => {
        createDraggable(icon, {
          container: "#floating-icons",
          releaseStiffness: 40,
          releaseDamping: 8,
          releaseMass: 1,
          releaseContainerFriction: 0.15,
          velocityMultiplier: 1.2,
          onGrab() {
            const rect = icon.getBoundingClientRect()
            const containerRect = container.getBoundingClientRect()
            icon.classList.remove("floating")
            icon.style.left = `${rect.left - containerRect.left}px`
            icon.style.top = `${rect.top - containerRect.top}px`
            icon.classList.add("dragging")
          },
          onRelease() {
            icon.classList.remove("dragging")
          },
        })
      })

    container.querySelectorAll("[data-not-draggable]").forEach((el) => {
      el.addEventListener("mouseenter", () => {
        document.documentElement.classList.add("party-mode")
      })
      el.addEventListener("mouseleave", () => {
        document.documentElement.classList.remove("party-mode")
      })
    })

    setupShakeDetection(container)
  }

  function setupShakeDetection(container: HTMLElement) {
    if (
      !window.matchMedia("(pointer: coarse)").matches ||
      !("ondevicemotion" in window)
    ) {
      return
    }

    let lastX = 0
    let lastY = 0
    let lastZ = 0
    let shakeTimeout: ReturnType<typeof setTimeout> | null = null
    let shakeCount = 0

    window.addEventListener("devicemotion", (e: DeviceMotionEvent) => {
      const acc = e.accelerationIncludingGravity
      if (!acc) return

      const deltaX = Math.abs((acc.x ?? 0) - lastX)
      const deltaY = Math.abs((acc.y ?? 0) - lastY)
      const deltaZ = Math.abs((acc.z ?? 0) - lastZ)

      lastX = acc.x ?? 0
      lastY = acc.y ?? 0
      lastZ = acc.z ?? 0

      if (deltaX + deltaY + deltaZ > SHAKE_THRESHOLD) {
        shakeCount++

        if (shakeCount >= SHAKE_COUNT_REQUIRED && !shakeTimeout) {
          shakeCount = 0
          scatterIcons(container)
          shakeTimeout = setTimeout(() => {
            shakeTimeout = null
          }, SHAKE_COOLDOWN_MS)
        }
      }
    })
  }

  function scatterIcons(container: HTMLElement) {
    const rect = container.getBoundingClientRect()
    container
      .querySelectorAll<HTMLElement>(DRAGGABLE_SELECTOR)
      .forEach((icon) => {
        icon.classList.remove("floating")
        icon.style.left = `${Math.random() * (rect.width - 40)}px`
        icon.style.top = `${Math.random() * (rect.height - 40)}px`
      })
  }

  setupFloatingIcons()
</script>
