---
import ThemeToggle from "@/components/layout/theme-toggle.astro"
import { siteConfig } from "@/config/site"

const links = [
  { href: siteConfig.links.github, label: "GitHub", external: true },
  { href: siteConfig.links.x, label: "X", external: true },
  { href: siteConfig.links.email, label: "Email", external: true },
  { href: siteConfig.links.linkedin, label: "LinkedIn", external: true },
  { href: "/rss.xml", label: "RSS", external: false }
]
---

<footer class="mt-20 flex items-center justify-between gap-4 border-t border-border pt-6">
  <nav class="flex flex-wrap gap-x-5 gap-y-2">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="label transition-colors hover:text-foreground"
          {...link.external
            ? { target: "_blank", rel: "noopener noreferrer" }
            : {}}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
  <ThemeToggle class="label" />
</footer>
