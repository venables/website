---
import ThemeToggle from "@/components/layout/theme-toggle.astro"
import { siteConfig } from "@/config/site"
---

<footer class="flex flex-col gap-4 border-t border-foreground/10 pt-8 text-muted-foreground">
  <nav class="flex flex-wrap gap-x-4 gap-y-1">
    <a class="link" target="_blank" rel="noopener noreferrer" href={siteConfig.links.github}>GitHub</a>
    <a class="link" target="_blank" rel="noopener noreferrer" href={siteConfig.links.x}>X</a>
    <a class="link" target="_blank" rel="noopener noreferrer" href={siteConfig.links.signal}>Signal</a>
    <a class="link" target="_blank" rel="noopener noreferrer" href={siteConfig.links.telegram}>Telegram</a>
    <a class="link" target="_blank" rel="noopener noreferrer" href={siteConfig.links.email}>Email</a>
    <a class="link" target="_blank" rel="noopener noreferrer" href={siteConfig.links.linkedin}>LinkedIn</a>
    <a class="link" href="/rss.xml">RSS</a>
    <a class="link" href="/now">Now</a>
  </nav>

  <p id="visitor-counter" class="text-center text-xs text-muted-foreground/40 font-mono tracking-wider"></p>

  <div class="flex items-center justify-between text-xs text-muted-foreground/60">
    <span class="flex items-center gap-2">
      <a class="link no-underline" href="/.well-known/did.json">{siteConfig.keys.did}</a>
      <span class="text-muted-foreground/30">|</span>
      <a class="link no-underline" href="/pgp">pgp</a>
    </span>
    <ThemeToggle />
  </div>
</footer>

<script>
  const counter = document.getElementById("visitor-counter")
  if (counter) {
    const base = 8_675_309 + Math.floor(Math.random() * 42_000)
    counter.textContent = `You are mass-produced visitor #${base.toLocaleString()}`
  }
</script>
