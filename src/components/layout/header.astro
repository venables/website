---
import { siteConfig } from "@/config/site"

const nav = [
  { href: "/", label: "Writing" },
  { href: "/projects", label: "Projects" },
  { href: "/now", label: "Now" }
]

const { pathname } = Astro.url

function isActive(href: string): boolean {
  return href === "/" ? pathname === "/" : pathname.startsWith(href)
}
---

<header class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
  <a
    href="/"
    class="font-mono text-sm uppercase tracking-[0.2em] transition-colors hover:text-muted-foreground"
  >
    {siteConfig.name}
  </a>
  <nav class="flex gap-5">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "label transition-colors hover:text-foreground",
            isActive(item.href) && "text-foreground"
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
