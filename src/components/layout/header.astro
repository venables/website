---
import Logo from "@/components/layout/logo.astro"

const nav = [
  { href: "/", label: "Writing" },
  { href: "/projects", label: "Projects" }
]

const { pathname } = Astro.url

function isActive(href: string): boolean {
  return href === "/" ? pathname === "/" : pathname.startsWith(href)
}
---

<header class="flex items-center justify-between gap-6">
  <a
    href="/"
    aria-label="Matt Venables — home"
    class="text-foreground transition-colors hover:text-muted-foreground"
  >
    <Logo class="h-7 w-auto" />
  </a>
  <nav class="flex items-center gap-4 sm:gap-5">
    {
      nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            "font-mono text-xs text-muted-foreground transition-colors hover:text-foreground",
            isActive(item.href) && "text-foreground"
          ]}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>
