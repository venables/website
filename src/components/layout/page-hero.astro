---
interface Props {
  title: string
  description?: string
}

const { title, description } = Astro.props
---

<header class="-mx-6 flex flex-col gap-4 bg-muted px-6 py-10 sm:-mx-8 sm:px-8 sm:py-14">
  <h1 class="font-serif text-4xl leading-[1.08] tracking-tight text-balance sm:text-5xl">
    {title}
  </h1>
  {description && <p class="text-muted-foreground">{description}</p>}
  <slot />
</header>
