---
import CodeTitle from "@/components/ui/code-title.astro"

interface Props {
  title: string
  subtitle?: string
  description?: string
}

const { title, subtitle, description } = Astro.props
---

<header class="flex flex-col gap-5">
  <div class="flex flex-col gap-2">
    <h1 class="font-serif text-4xl leading-[1.08] tracking-tight text-balance sm:text-5xl">
      <CodeTitle text={title} />
    </h1>
    {subtitle && <p class="label">{subtitle}</p>}
  </div>
  {
    description && (
      <p class="max-w-prose leading-relaxed text-muted-foreground">
        {description}
      </p>
    )
  }
  <slot />
</header>
