---
import "@fontsource-variable/jetbrains-mono"
import "@fontsource-variable/geist-mono"
import "@/styles/globals.css"
import FloatingIcons from "@/components/floating-icons.astro"
import Footer from "@/components/layout/footer.astro"
import TailwindIndicator from "@/components/layout/tailwind-indicator.astro"
import TheNet from "@/components/layout/the-net.astro"
import RootLayout from "@/layouts/_root.astro"
import type { RootLayoutProps } from "@/layouts/_root.types"

type Props = RootLayoutProps

const props = Astro.props
---

<RootLayout
  class="min-h-svh font-sans text-base leading-7 antialiased selection:bg-accent dark:selection:text-background"
  {...props}
>
  <div class="relative z-10 flex min-h-svh flex-col p-6 sm:p-12">
    <FloatingIcons />
    <main class="flex grow flex-col gap-12">
      <slot />
    </main>
    <Footer />
    <TheNet />
  </div>
  {import.meta.env.DEV && <TailwindIndicator />}
</RootLayout>

<script>
  // Sparkle cursor trail
  const sparkles = ["*", "+", "~", "."]
  document.addEventListener("mousemove", (e) => {
    if (Math.random() > 0.3) return
    const spark = document.createElement("span")
    spark.textContent = sparkles[Math.floor(Math.random() * sparkles.length)]
    spark.style.cssText = `
      position: fixed;
      left: ${e.clientX}px;
      top: ${e.clientY}px;
      pointer-events: none;
      font-size: ${8 + Math.random() * 14}px;
      color: hsl(${Math.random() * 360}, 80%, 65%);
      z-index: 9999;
      animation: sparkle-fade 0.8s ease-out forwards;
      font-weight: bold;
    `
    document.body.appendChild(spark)
    spark.addEventListener("animationend", () => spark.remove())
  })

  // Konami code: flip the entire page upside down and spin it
  const konamiCode = [
    "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
    "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight",
    "b", "a",
  ]
  let konamiIndex = 0

  document.addEventListener("keydown", (e) => {
    if (e.key === konamiCode[konamiIndex]) {
      konamiIndex++
      if (konamiIndex === konamiCode.length) {
        konamiIndex = 0
        document.body.style.transition = "transform 2s ease-in-out"
        document.body.style.transform = "rotate(180deg) scale(0.8)"
        setTimeout(() => {
          document.body.style.transform = "rotate(360deg) scale(1)"
          setTimeout(() => {
            document.body.style.transform = ""
          }, 2000)
        }, 2000)
      }
    } else {
      konamiIndex = 0
    }
  })

  const originalTitle = document.title
  const guilts = [
    "Come back :(",
    "I miss you already",
    "Was it something I said?",
    "The vibes are off without you",
    "Hello? Is this thing on?",
    "Don't leave me with the floating icons",
  ]

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) {
      document.title = guilts[Math.floor(Math.random() * guilts.length)]!
    } else {
      document.title = originalTitle
    }
  })
</script>
