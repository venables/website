---
import "@/styles/globals.css"
import Footer from "@/components/layout/footer.astro"
import Header from "@/components/layout/header.astro"
import TailwindIndicator from "@/components/layout/tailwind-indicator.astro"
import RootLayout from "./_root.astro"
import type { RootLayoutProps } from "./_root.types"

type Props = RootLayoutProps

const props = Astro.props
---

<RootLayout {...props}>
  <div class="mx-auto flex min-h-svh w-full max-w-2xl flex-col px-6 py-10 sm:px-8 sm:py-14">
    <Header />
    <main class="flex grow flex-col gap-16 pt-14">
      <slot />
    </main>
    <Footer />
  </div>
  {import.meta.env.DEV && <TailwindIndicator />}
</RootLayout>
