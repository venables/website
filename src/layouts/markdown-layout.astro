---
import Article from "@/components/articles/article.astro"
import Layout from "./layout.astro"

interface Props {
  content: {
    title: string
    description?: string
  }
}

const { content } = Astro.props
---

<Layout title={content.title} description={content.description}>
  <article class="flex flex-col gap-12">
    <header class="-mx-6 flex flex-col gap-3 bg-muted px-6 py-10 sm:-mx-8 sm:px-8 sm:py-14">
      <h1 class="font-serif text-4xl leading-[1.08] tracking-tight sm:text-5xl">
        {content.title}
      </h1>
      {
        content.description && (
          <p class="text-muted-foreground">{content.description}</p>
        )
      }
    </header>
    <Article>
      <slot />
    </Article>
  </article>
</Layout>
