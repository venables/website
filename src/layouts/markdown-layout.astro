---
import Article from "@/components/articles/article.astro"
import Layout from "./layout.astro"

interface Props {
  content: {
    title: string
    description?: string
  }
}

const { content } = Astro.props
---

<Layout title={content.title} description={content.description}>
  <div class="flex flex-col gap-8">
    <header class="flex flex-col gap-2">
      <h1 class="font-serif text-4xl leading-tight tracking-tight sm:text-5xl">
        {content.title}
      </h1>
      {
        content.description && (
          <p class="text-lg text-muted-foreground">{content.description}</p>
        )
      }
    </header>
    <Article>
      <slot />
    </Article>
  </div>
</Layout>
