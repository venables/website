---
import Article from "@/components/articles/article.astro"
import PageHero from "@/components/layout/page-hero.astro"
import Layout from "@/layouts/layout.astro"
import { getCollection, getEntry, render } from "astro:content"

export async function getStaticPaths() {
  const allPosts = await getCollection("posts")
  return allPosts.map((post) => ({ params: { id: post.id } }))
}

async function getContent(id: string) {
  const entry = await getEntry("posts", id)
  if (!entry) {
    throw new Error(`Entry ${id} not found`)
  }

  const { Content } = await render(entry)
  return { entry, Content }
}

function readingTime(body: string | undefined): number {
  const words = (body ?? "").trim().split(/\s+/).filter(Boolean).length
  return Math.max(1, Math.round(words / 200))
}

const { id } = Astro.params
const { entry, Content } = await getContent(id)

const title = entry.data.title ?? "Untitled"
const description = entry.data.description ?? ""
const date = entry.data.pubDate?.toISOString() ?? new Date().toISOString()

const meta = [
  entry.data.pubDate?.toLocaleDateString("en-US", {
    timeZone: "UTC",
    year: "numeric",
    month: "long",
    day: "numeric"
  }),
  `${readingTime(entry.body)} min read`
]
  .filter(Boolean)
  .join(" · ")
---

<Layout
  title={title}
  description={description}
  article={{ date }}
  image={{
    url: `${Astro.site}og/${id}.png`,
    alt: title,
    width: 1200,
    height: 630
  }}
>
  <article class="flex flex-col gap-12">
    <PageHero title={title}>
      <p class="label">{meta}</p>
    </PageHero>
    <Article>
      <Content />
    </Article>
  </article>
</Layout>
