---
import { getCollection, getEntry, render } from "astro:content"
import WideLayout from "../layouts/wide-layout.astro"

export async function getStaticPaths() {
  const allPosts = await getCollection("posts")
  return allPosts.map((post) => ({ params: { id: post.id } }))
}

async function getContent(id: string) {
  const entry = await getEntry("posts", id)
  if (!entry) {
    throw new Error(`Entry ${id} not found`)
  }

  const { Content } = await render(entry)
  return { entry, Content }
}

const { id } = Astro.params
const { entry, Content } = await getContent(id)

const title = entry.data.title ?? "Untitled"
const description = entry.data.description ?? ""
const date = entry.data.pubDate?.toISOString() ?? new Date().toISOString()

const rotation = (Math.random() * 1.5 - 0.75)
---

<WideLayout title={title} description={description} article={{ date }}>
  <article class="post">
    <!-- Massive Hero Title -->
    <header class="post-header" style={`transform: rotate(${rotation}deg)`}>
      <h1 class="post-title">{title}</h1>
      {entry.data.pubDate && (
        <time class="post-date">{entry.data.pubDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}</time>
      )}
    </header>

    <!-- Content -->
    <div class="post-content">
      <Content />
    </div>

    <!-- Navigation -->
    <nav class="post-nav">
      <a href="/" class="nav-link">← Index</a>
    </nav>
  </article>
</WideLayout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .post-header {
    padding: clamp(4rem, 15vh, 8rem) clamp(1rem, 5vw, 3rem);
    background: var(--color-background);
    border-bottom: 3px solid var(--color-foreground);
    transition: transform 0.3s ease-out;
  }

  .post-header:hover {
    transform: rotate(0deg);
  }

  .post-title {
    font-size: clamp(2.5rem, 12vw, 8rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--color-foreground);
    margin: 0;
    word-break: break-word;
    text-shadow: 3px 3px 0 var(--color-accent);
  }

  .post-date {
    display: block;
    margin-top: 1.5rem;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: clamp(0.75rem, 2vw, 1rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-muted-foreground);
  }

  .post-content {
    padding: clamp(2rem, 8vw, 5rem) clamp(1rem, 5vw, 3rem);
    max-width: 75ch;
    margin: 0 auto;
    width: 100%;
  }

  .post-content :global(h1) {
    display: none;
  }

  .post-content :global(h2) {
    font-size: clamp(1.5rem, 5vw, 2.5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-top: 3rem;
    margin-bottom: 1.5rem;
    color: var(--color-foreground);
  }

  .post-content :global(h3) {
    font-size: clamp(1.25rem, 4vw, 1.75rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    color: var(--color-foreground);
  }

  .post-content :global(p) {
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.8;
    margin-bottom: 1.75rem;
    color: var(--color-foreground);
  }

  .post-content :global(ul), .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
    font-size: clamp(1rem, 2.5vw, 1.25rem);
    line-height: 1.8;
  }

  .post-content :global(li) {
    margin-bottom: 0.75rem;
  }

  .post-content :global(li::marker) {
    color: var(--color-foreground);
    font-weight: 700;
  }

  .post-content :global(a) {
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    font-weight: 600;
    transition: all 0.15s ease;
  }

  .post-content :global(a:hover) {
    text-decoration-style: solid;
    background: var(--color-foreground);
    color: var(--color-background);
    padding: 0 0.25rem;
    margin: 0 -0.25rem;
  }

  .post-content :global(strong) {
    font-weight: 800;
    color: var(--color-foreground);
  }

  .post-content :global(em) {
    font-style: italic;
    color: var(--color-foreground);
  }

  .post-content :global(code) {
    background: var(--color-accent);
    padding: 0.15rem 0.4rem;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.85em;
    border: 1px solid var(--color-foreground);
    font-weight: 500;
  }

  .post-content :global(pre) {
    background: var(--color-foreground);
    color: var(--color-background);
    padding: 1.5rem;
    overflow-x: auto;
    border: 3px solid var(--color-foreground);
    box-shadow: 6px 6px 0 var(--color-accent);
    margin: 2rem 0;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .post-content :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-foreground);
    padding-left: 1.5rem;
    margin: 2rem 0;
    font-style: italic;
    font-size: clamp(1.1rem, 3vw, 1.35rem);
    line-height: 1.7;
    color: var(--color-foreground);
  }

  .post-content :global(blockquote p) {
    margin-bottom: 0;
  }

  .post-content :global(hr) {
    border: none;
    border-top: 3px solid var(--color-foreground);
    margin: 3rem 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border: 3px solid var(--color-foreground);
    box-shadow: 6px 6px 0 var(--color-accent);
    margin: 2rem 0;
  }

  .post-nav {
    padding: 2rem clamp(1rem, 5vw, 3rem);
    border-top: 3px solid var(--color-foreground);
    background: var(--color-accent);
  }

  .nav-link {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-foreground);
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .nav-link:hover {
    text-decoration: underline;
    text-decoration-style: wavy;
    text-underline-offset: 3px;
  }

  @media (max-width: 640px) {
    .post-content {
      padding: 1.5rem 1rem;
    }

    .post-header {
      padding: 2rem 1rem;
    }

    .post-title {
      text-shadow: 2px 2px 0 var(--color-accent);
    }
  }
</style>
