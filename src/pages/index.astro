---
import ArticleListSection from "@/components/articles/list-section.astro"
import Layout from "@/layouts/home-layout.astro"
import { siteConfig } from "@/config/site"

const title = siteConfig.author.name
const description = "I build successful decentralized products."
---

<Layout title={title} description={description}>
  <section class="hero">
    <div class="hero-content">
      <p class="tagline">claude converser</p>
      <h1 class="name">
        <span class="name-line">Matt</span>
        <span class="name-line">Venables</span>
      </h1>
    </div>
  </section>

  <section class="about">
    <div class="about-card">
      <div class="card-header">
        <span class="card-icon">i</span>
        <span class="card-title">ABOUT.ME</span>
        <div class="window-buttons">
          <button class="btn minimize" data-action="minimize">_</button>
          <button class="btn maximize" data-action="maximize">□</button>
          <button class="btn close" data-action="close">×</button>
        </div>
      </div>
      <div class="card-content">
        <p class="details">
          I am co-founder and CTO of <a href="https://catena.xyz" class="link">Catena Labs</a>,
          giving AI agents financial superpowers. Previously helped create
          <a href="https://usdc.cool" class="link">USDC</a> at Circle.
        </p>
        <div class="divider">
          <span class="divider-text">CONNECT</span>
        </div>
        <p class="contact">
          Find me on <a href={siteConfig.links.github} class="link">GitHub</a> or
          <a href={siteConfig.links.x} class="link">X</a>. Reach me on
          <a href={siteConfig.links.telegram} class="link">Telegram</a> or
          <a href={siteConfig.links.signal} class="link">Signal</a>.
        </p>
      </div>
    </div>
  </section>

  <ArticleListSection />
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    position: relative;
    overflow: visible;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .tagline {
    font-size: clamp(1rem, 3vw, 1.5rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-muted-foreground);
    transform: rotate(-3deg);
    margin-bottom: 0.5rem;
  }

  .name {
    display: flex;
    flex-direction: column;
    line-height: 0.85;
    margin: 0;
  }

  .name-line {
    font-size: clamp(4rem, 15vw, 50rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    display: block;
    color: var(--color-foreground);
    text-shadow: 3px 3px 6px rgba(0, 0, 0, 0.15);
    transform: rotate(var(--name-base-rotate)) translateX(var(--name-base-x));
    animation: float-name var(--name-float-duration) ease-in-out infinite;
  }

  .name-line:first-child {
    --name-float-y: -8px;
    --name-base-rotate: -2deg;
    --name-base-x: -5%;
    --name-float-duration: 8s;
  }

  .name-line:last-child {
    --name-float-y: 6px;
    --name-base-rotate: 2deg;
    --name-base-x: 5%;
    --name-float-duration: 10s;
  }

  @keyframes float-name {
    0%, 100% {
      transform: rotate(var(--name-base-rotate)) translateX(var(--name-base-x)) translateY(0);
    }
    50% {
      transform: rotate(var(--name-base-rotate)) translateX(var(--name-base-x)) translateY(var(--name-float-y));
    }
  }

  .about {
    max-width: 78ch;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    padding: 0 1rem;
  }

  .about-card {
    background: var(--color-background);
    border: 3px solid var(--color-foreground);
    box-shadow:
      4px 4px 0 var(--color-foreground),
      8px 8px 0 rgba(0, 0, 0, 0.1);
    width: 100%;
    transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-1deg) scale(var(--current-scale, 1));
    transition: transform 0.3s ease-out;
    position: relative;
  }

  .about-card:hover {
    filter: brightness(1.02);
  }

  .card-header {
    background: var(--color-foreground);
    color: var(--color-background);
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: grab;
    user-select: none;
  }

  .card-header:active {
    cursor: grabbing;
  }

  .card-icon {
    width: 1.25rem;
    height: 1.25rem;
    background: var(--color-background);
    color: var(--color-foreground);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-style: italic;
  }

  .card-title {
    flex: 1;
  }

  .window-buttons {
    display: flex;
    gap: 0.25rem;
  }

  .window-buttons .btn {
    width: 1.25rem;
    height: 1.25rem;
    background: var(--color-background);
    color: var(--color-foreground);
    border: none;
    font-family: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.1s ease, filter 0.1s ease;
  }

  .window-buttons .btn:hover {
    transform: scale(1.15);
    filter: brightness(1.1);
  }

  .window-buttons .btn:active {
    transform: scale(0.95);
  }

  .about-card.minimized .card-content {
    display: none;
  }

  .about-card.minimized {
    transform: rotate(-2deg) scale(0.95);
    opacity: 0.8;
  }

  .about-card.glitch-out {
    animation: glitch-out 0.3s ease-in forwards;
    pointer-events: none;
    transition: none;
  }

  .about-card.glitch-in {
    animation: glitch-in 0.4s ease-out forwards;
    transition: none;
  }

  .about-card.popping {
    animation: pop 0.35s ease-out forwards;
  }

  .about-card.dragging {
    transition: none;
    cursor: grabbing;
  }

  .about-card.dragging .card-header {
    cursor: grabbing;
  }

  @keyframes glitch-out {
    0% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-1deg) scale(var(--current-scale, 1));
      opacity: 1;
      filter: none;
    }
    20% {
      transform: translate(calc(var(--drag-x, 0px) + 5px), var(--drag-y, 0px)) rotate(2deg) scale(calc(var(--current-scale, 1) * 1.05));
      filter: hue-rotate(90deg) saturate(2);
    }
    40% {
      transform: translate(calc(var(--drag-x, 0px) - 8px), var(--drag-y, 0px)) rotate(-3deg) scale(calc(var(--current-scale, 1) * 0.95));
      filter: hue-rotate(180deg) invert(1);
    }
    60% {
      transform: translate(calc(var(--drag-x, 0px) + 3px), var(--drag-y, 0px)) rotate(4deg) scale(calc(var(--current-scale, 1) * 1.02));
      filter: hue-rotate(270deg) blur(2px);
    }
    80% {
      transform: translate(calc(var(--drag-x, 0px) - 5px), var(--drag-y, 0px)) rotate(-5deg) scale(calc(var(--current-scale, 1) * 0.9));
      filter: hue-rotate(45deg) contrast(2);
      opacity: 0.5;
    }
    100% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(10deg) scale(0);
      opacity: 0;
      filter: hue-rotate(360deg) blur(10px);
    }
  }

  @keyframes glitch-in {
    0% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(10deg) scale(0);
      opacity: 0;
      filter: hue-rotate(360deg) blur(10px);
    }
    30% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-5deg) scale(calc(var(--current-scale, 1) * 1.1));
      opacity: 0.7;
      filter: hue-rotate(180deg) saturate(2);
    }
    60% {
      transform: translate(calc(var(--drag-x, 0px) * 0.5), calc(var(--drag-y, 0px) * 0.5)) rotate(3deg) scale(calc(var(--current-scale, 1) * 0.95));
      opacity: 0.9;
      filter: hue-rotate(90deg);
    }
    100% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-1deg) scale(var(--current-scale, 1));
      opacity: 1;
      filter: none;
    }
  }

  @keyframes pop {
    0% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-1deg) scale(calc(var(--current-scale, 1) / 1.05));
    }
    15% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-1deg) scale(calc(var(--current-scale, 1) / 1.05 * 0.97));
    }
    60% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-1deg) scale(calc(var(--current-scale, 1) * 1.02));
    }
    100% {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-1deg) scale(var(--current-scale, 1));
    }
  }

  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .details,
  .contact {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-foreground);
    text-align: left;
    margin: 0;
  }

  .contact {
    font-size: 0.95rem;
  }

  .divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0.5rem 0;
  }

  .divider::before,
  .divider::after {
    content: "";
    flex: 1;
    height: 2px;
    background: repeating-linear-gradient(
      90deg,
      var(--color-foreground) 0px,
      var(--color-foreground) 4px,
      transparent 4px,
      transparent 8px
    );
    opacity: 0.4;
  }

  .divider-text {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-muted-foreground);
    letter-spacing: 0.15em;
    background: var(--color-background);
    padding: 0 0.5rem;
  }

  .link {
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-style: wavy;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .link:hover {
    text-decoration-style: solid;
    background: var(--color-foreground);
    color: var(--color-background);
    padding: 0 0.25rem;
    margin: 0 -0.25rem;
  }

  @media (min-width: 1440px) {
    .name-line {
      font-size: 18vw;
    }
  }

  @media (min-width: 1920px) {
    .name-line {
      font-size: 22vw;
    }
  }

  @media (min-width: 2560px) {
    .name-line {
      font-size: 26vw;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 35vh;
    }

    .name-line {
      font-size: clamp(3.5rem, 18vw, 6rem);
    }

    .name-line:first-child {
      --name-float-y: -6px;
    }

    .name-line:last-child {
      --name-float-y: 4px;
    }

    .about-card {
      transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(-0.5deg) scale(var(--current-scale, 1));
    }

    .card-content {
      padding: 1.25rem;
    }

    .details,
    .contact {
      font-size: 0.95rem;
      line-height: 1.6;
    }
  }
</style>

<script>
  function delay(ms: number): Promise<void> {
    return new Promise((resolve) => setTimeout(resolve, ms))
  }

  function setupWindowButtons() {
    const card = document.querySelector(".about-card") as HTMLElement | null
    const buttons = card?.querySelectorAll(".window-buttons .btn")
    const header = card?.querySelector(".card-header") as HTMLElement | null

    if (!card || !buttons) return

    let isMinimized = false
    let scale = 1

    const drag = header ? setupDragging(card, header) : null

    function handleMinimize() {
      isMinimized = !isMinimized
      card.classList.toggle("minimized", isMinimized)
    }

    function handleMaximize() {
      scale *= 1.05
      card.style.setProperty("--current-scale", String(scale))
      card.classList.remove("popping")
      void card.offsetWidth
      card.classList.add("popping")
    }

    async function handleClose() {
      card.classList.remove("popping")
      card.classList.add("glitch-out")
      isMinimized = false
      scale = 1

      await delay(2000)

      card.style.removeProperty("--current-scale")
      card.style.removeProperty("--drag-x")
      card.style.removeProperty("--drag-y")
      drag?.reset()
      card.classList.remove("glitch-out", "minimized", "popping")
      card.classList.add("glitch-in")

      await delay(400)

      card.classList.remove("glitch-in")
    }

    const actions: Record<string, () => void> = {
      minimize: handleMinimize,
      maximize: handleMaximize,
      close: handleClose,
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const action = btn.getAttribute("data-action")
        if (action) {
          actions[action]?.()
        }
      })
    })
  }

  function setupDragging(card: HTMLElement, header: HTMLElement) {
    let isDragging = false
    let startX = 0
    let startY = 0
    let currentX = 0
    let currentY = 0

    function onMouseDown(e: MouseEvent) {
      if ((e.target as HTMLElement).closest(".window-buttons")) return
      isDragging = true
      startX = e.clientX - currentX
      startY = e.clientY - currentY
      card.classList.add("dragging")
    }

    function onMouseMove(e: MouseEvent) {
      if (!isDragging) return
      e.preventDefault()
      currentX = e.clientX - startX
      currentY = e.clientY - startY
      card.style.setProperty("--drag-x", `${currentX}px`)
      card.style.setProperty("--drag-y", `${currentY}px`)
    }

    function onMouseUp() {
      if (!isDragging) return
      isDragging = false
      card.classList.remove("dragging")
    }

    header.addEventListener("mousedown", onMouseDown)
    document.addEventListener("mousemove", onMouseMove)
    document.addEventListener("mouseup", onMouseUp)

    return {
      reset() {
        currentX = 0
        currentY = 0
      },
    }
  }

  setupWindowButtons()
</script>
