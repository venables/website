---
import PageHero from "@/components/layout/page-hero.astro"
import Layout from "@/layouts/layout.astro"
import { siteConfig } from "@/config/site"

interface Project {
  name: string
  description: string
  href: string
}

const projects: Project[] = [
  {
    name: "usdc.cool",
    description: "The USDC stablecoin supply tracker.",
    href: "https://usdc.cool"
  },
  {
    name: "Stablewars",
    description: "Cross-chain stablecoin analytics.",
    href: "https://stablewars.xyz"
  },
  {
    name: "songbpm",
    description: "Song metadata for over half a million visitors every month.",
    href: "https://songbpm.com"
  },
  {
    name: "jog.fm",
    description:
      "The best music for your workout, with hundreds of thousands of monthly uniques.",
    href: "https://jog.fm"
  },
  {
    name: "typed-route-handler",
    description: "Type-safe API routes for Next.js.",
    href: "https://github.com/venables/typed-route-handler"
  },
  {
    name: "Instamint",
    description: "The easiest way to mint an NFT on Solana.",
    href: "https://nft.m2.xyz"
  },
  {
    name: "startkit",
    description: "Robust starter kits for building apps that scale.",
    href: "https://github.com/startkit-dev"
  },
  {
    name: "npx hello",
    description: "Browse GitHub profiles from the command line.",
    href: "https://github.com/hello-js/hello"
  },
  {
    name: "koa-helmet",
    description: "Important security headers for the Koa framework.",
    href: "https://github.com/venables/koa-helmet"
  }
]

const title = "Projects"
const description = "A snapshot of what I've built."
---

<Layout title={title} description={description}>
  <article class="flex flex-col gap-12">
    <PageHero title={title} description={description} />

    <ul class="group/list flex flex-col">
      {
        projects.map((project) => (
          <li>
            <a
              href={project.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col gap-1 py-3 no-underline transition-opacity duration-200 group-hover/list:opacity-40 hover:!opacity-100"
            >
              <span class="font-serif text-lg leading-snug">
                {project.name}
                <span class="ms-1 font-mono text-xs text-muted-foreground">
                  ↗
                </span>
              </span>
              <span class="text-sm leading-snug text-muted-foreground">
                {project.description}
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="text-sm text-muted-foreground">
      See more of my open source work on <a
        href={siteConfig.links.github}
        target="_blank"
        rel="noopener noreferrer"
        class="link">GitHub</a
      >.
    </p>
  </article>
</Layout>
