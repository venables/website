{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2025-03-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
